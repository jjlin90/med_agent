# OpenAI 兼容模型服务
OPENAI_API_KEY=replace-with-your-key
MODEL_API_BASE_URL=https://your-provider.example/v1
BASE_LLM=your-chat-model
SMALL_LLM=your-chat-model
DOMAIN_INTENT_MIN_CONFIDENCE=0.65
SAFETY_INTENT_MIN_CONFIDENCE=0.75

# 嵌入与重排
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
ENABLE_RERANK=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# 本地数据与持久化路径
MSD_DATA_PATH=C:/path/to/MSDZHConsumerMedicalTopics
VECTORSTORE_PATH=vectorstore/chroma
BM25_PATH=vectorstore/bm25.json
CHECKPOINT_PATH=data/checkpoints.sqlite
SECURE_LOG_PATH=data/sessions.enc
ENABLE_SECURE_SESSION_LOG=false

# 普通运行日志（脱敏、按大小轮转）
ENABLE_FILE_LOG=true
LOG_PATH=logs/med_agent.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Agent 安全上限
MAX_AGENT_TOOL_ROUNDS=6
